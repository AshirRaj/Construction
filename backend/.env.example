# ==========================================
# BuildCore Backend Environment Variables
# ==========================================

# Server Configuration
PORT=5000
NODE_ENV=production

# MongoDB Atlas Connection URI
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/construction?retryWrites=true&w=majority

# Authentication Secrets
JWT_SECRET=your_super_secret_jwt_random_key_here
JWT_EXPIRES_IN=7d

# Frontend Client URL (For CORS & Cookie Domain, e.g. https://your-frontend.vercel.app)
CLIENT_URL=http://localhost:5173

# Default Admin Credentials (Used by Seeder)
ADMIN_NAME=Alex Mercer
ADMIN_EMAIL=admin@buildcore.com
ADMIN_PASSWORD=Admin@123
